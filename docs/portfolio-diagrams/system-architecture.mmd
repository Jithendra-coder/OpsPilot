flowchart LR
  subgraph Clients["CLIENTS & ENTRY POINTS"]
    Browser["Operator / approver<br/>Static browser UI"]
    Alert["Alert sender<br/>Bearer-auth webhook"]
    McpHost["Local MCP host"]
  end

  subgraph Runtime["OPSPILOT API PROCESS · UVICORN · ONE WORKER"]
    ASGI["FastAPI ASGI shell<br/>Static routes · headers · request telemetry"]
    Adapter["Versioned API adapter<br/>64 KiB cap · Starlette threadpool"]
    Handler["Synchronous Handler.route<br/>Session · role · CSRF · input checks"]
    Incident["Incident lifecycle<br/>SQLite transactions · idempotency"]
    Graph["Checkpointed LangGraph<br/>Scope → context → logs → metrics → traces → changes"]
    Diagnosis["Deterministic signature engine<br/>Inconclusive on weak or failed evidence"]
    Catalog["Shared bounded read-only tool catalog<br/>Incident dependency scope · 50 rows · 7 days"]
    Action["Typed remediation gate<br/>Immutable parameters · two-person approval"]
    Verify["Simulator executor + server-owned verification"]
    ASGI --> Adapter --> Handler --> Incident --> Graph
    Graph --> Catalog --> Graph
    Graph --> Diagnosis --> Incident
    Incident --> Action --> Verify --> Incident
  end

  subgraph State["PERSISTENT STATE"]
    OpsDB[("SQLite operational store<br/>opspilot.db")]
    Checkpoint[("LangGraph checkpoint<br/>SQLite default · optional PostgreSQL")]
  end

  subgraph Adjacent["SEPARATE OR OPTIONAL CONNECTIONS"]
    MCP["Local MCP stdio server<br/>10 read-only tools"]
    LLM["OpenAI-compatible HTTPS provider<br/>Explicit consent · ranking only"]
    Metrics["Prometheus registry<br/>Optional OTLP traces + metrics"]
  end

  Browser --> ASGI
  Alert --> Adapter
  Handler --> OpsDB
  Catalog --> OpsDB
  Incident --> OpsDB
  Verify --> OpsDB
  Graph <--> Checkpoint
  McpHost --> MCP --> Catalog
  Graph -. "consent + HTTPS" .-> LLM
  ASGI --> Metrics

